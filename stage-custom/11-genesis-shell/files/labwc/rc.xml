<?xml version="1.0" encoding="UTF-8"?>
<!-- labwc configuration for the Genesis session (/etc/xdg/genesis/labwc).
     Copy to ~/.config/genesis/labwc/rc.xml to customise. -->
<labwc_config>

  <core>
    <decoration>server</decoration>
    <gap>10</gap>
    <adaptiveSync>no</adaptiveSync>
    <allowTearing>no</allowTearing>
    <autoEnableOutputs>yes</autoEnableOutputs>
  </core>

  <placement>
    <policy>center</policy>
  </placement>

  <theme>
    <name>GenesisGlass</name>
    <cornerRadius>12</cornerRadius>
    <keepBorder>yes</keepBorder>
    <dropShadows>yes</dropShadows>
    <font place="ActiveWindow"><name>Inter</name><size>10.5</size><weight>Medium</weight></font>
    <font place="InactiveWindow"><name>Inter</name><size>10.5</size><weight>Medium</weight></font>
    <font place="MenuItem"><name>Inter</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>Inter</name><size>10</size><weight>Medium</weight></font>
    <titlebar>
      <layout>:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
  </theme>

  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <snapping>
    <range>12</range>
    <overlay enabled="yes">
      <delay inner="400" outer="400" />
    </overlay>
    <topMaximize>yes</topMaximize>
  </snapping>

  <desktops>
    <popupTime>600</popupTime>
    <names>
      <name>Workspace 1</name>
      <name>Workspace 2</name>
      <name>Workspace 3</name>
      <name>Workspace 4</name>
    </names>
  </desktops>

  <windowSwitcher show="yes" preview="yes" outlines="yes" allWorkspaces="no">
    <fields>
      <field content="desktop_entry_name" width="35%" />
      <field content="title" width="65%" />
    </fields>
  </windowSwitcher>

  <keyboard>
    <numlock>off</numlock>
    <default />

    <!-- Genesis Shell -->
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="genesis-shell-ctl launcher" /></keybind>
    <keybind key="W-space"><action name="Execute" command="genesis-shell-ctl launcher" /></keybind>
    <keybind key="W-a"><action name="Execute" command="genesis-shell-ctl launcher" /></keybind>
    <keybind key="W-c"><action name="Execute" command="genesis-shell-ctl control-center" /></keybind>
    <keybind key="W-n"><action name="Execute" command="genesis-shell-ctl notifications" /></keybind>
    <keybind key="W-i"><action name="Execute" command="genesis-settings" /></keybind>
    <keybind key="W-l"><action name="Execute" command="genesis-shell-ctl lock" /></keybind>
    <keybind key="W-Escape"><action name="Execute" command="genesis-shell-ctl hide" /></keybind>
    <keybind key="C-A-Delete"><action name="Execute" command="genesis-shell-ctl power" /></keybind>
    <keybind key="XF86PowerOff" onRelease="yes"><action name="Execute" command="genesis-shell-ctl power" /></keybind>

    <!-- applications -->
    <keybind key="W-Return"><action name="Execute" command="lxterminal" /></keybind>
    <keybind key="W-t"><action name="Execute" command="lxterminal" /></keybind>
    <keybind key="C-A-t"><action name="Execute" command="lxterminal" /></keybind>
    <keybind key="W-e"><action name="Execute" command="pcmanfm" /></keybind>
    <keybind key="W-b"><action name="Execute" command="x-www-browser" /></keybind>
    <keybind key="Print"><action name="Execute" command="genesis-shell-ctl screenshot screen" /></keybind>
    <keybind key="S-Print"><action name="Execute" command="genesis-shell-ctl screenshot area" /></keybind>

    <!-- windows -->
    <keybind key="W-q"><action name="Close" /></keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
    <keybind key="W-Up"><action name="ToggleMaximize" /></keybind>
    <keybind key="W-Down"><action name="Iconify" /></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" /></keybind>
    <keybind key="W-f"><action name="ToggleFullscreen" /></keybind>
    <keybind key="W-Tab"><action name="NextWindow" /></keybind>
    <keybind key="A-Tab"><action name="NextWindow" /></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow" /></keybind>
    <keybind key="A-Left" />
    <keybind key="A-Right" />
    <keybind key="A-Up" />
    <keybind key="A-Down" />

    <!-- workspaces -->
    <keybind key="W-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4" /></keybind>
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" /></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" /></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" /></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" /></keybind>
    <keybind key="W-Page_Down"><action name="GoToDesktop" to="right" /></keybind>
    <keybind key="W-Page_Up"><action name="GoToDesktop" to="left" /></keybind>

    <!-- media and hardware keys -->
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="genesis-shell-ctl volume-up" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="genesis-shell-ctl volume-down" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="genesis-shell-ctl volume-mute" /></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="genesis-shell-ctl brightness-up" /></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="genesis-shell-ctl brightness-down" /></keybind>
    <keybind key="C-A-m"><action name="ToggleMagnify" /></keybind>
    <keybind key="W-equal"><action name="ZoomIn" /></keybind>
    <keybind key="W-minus"><action name="ZoomOut" /></keybind>
  </keyboard>

  <mouse>
    <default />
    <context name="Root">
      <mousebind button="Right" action="Press"><action name="ShowMenu" menu="root-menu" /></mousebind>
      <mousebind direction="Up" action="Scroll"><action name="GoToDesktop" to="left" /></mousebind>
      <mousebind direction="Down" action="Scroll"><action name="GoToDesktop" to="right" /></mousebind>
    </context>
  </mouse>

  <libinput>
    <device category="touchpad">
      <naturalScroll>yes</naturalScroll>
      <tap>yes</tap>
      <clickMethod>clickfinger</clickMethod>
      <disableWhileTyping>yes</disableWhileTyping>
    </device>
  </libinput>

  <magnifier>
    <width>480</width>
    <height>480</height>
    <initScale>2.0</initScale>
    <increment>0.25</increment>
    <useFilter>true</useFilter>
  </magnifier>

</labwc_config>
