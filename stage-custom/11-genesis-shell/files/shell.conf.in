# Genesis Shell defaults for this image (/etc/genesis/shell.conf).
# Per-user overrides live in ~/.config/genesis/shell.conf (Genesis Settings writes them).

[wallpaper]
file = /usr/share/genesis/wallpapers/@WALLPAPER@.jpg
mode = zoom

[panel]
position = @PANEL_POSITION@
height = 44
floating = true
launchers = @LAUNCHERS@
clock_format = %a %d %b   %H:%M
show_seconds = false

[appearance]
accent = @ACCENT@
glass_opacity = 0.62

[notifications]
timeout = 6
do_not_disturb = false

[launcher]
columns = 7
icon_size = 64

[idle]
blank_timeout = @BLANK_TIMEOUT@
lock_on_idle = false

[sensors]
# NodoAI sensor boxes A-K on the I2C bus: a bar on the right edge that appears
# while at least one box is connected, with a notification when one comes or goes
enabled = true
bus = 1
poll_ms = 2000
notify = true
show_disconnected = false

[desktop]
# icons for the files, folders and launchers in ~/Desktop; label colour follows the wallpaper
icons = true
show_home = true
show_trash = true

[shortcuts]
terminal = lxterminal
files = pcmanfm
settings = genesis-settings
display_settings = raindrop
