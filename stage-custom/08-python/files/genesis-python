#!/bin/sh
# genesis-python: which Python is which on Genesis OS.
#
#   genesis-python          list the system and user Pythons
#   genesis-python --help   this text
#
# System Python  /usr/bin/python3: belongs to the OS (apt, desktop, settings).
#                Do not pip-install into it; Debian blocks that anyway.
# User Pythons   python3.10, python3.15, ... under /opt/python, plus "python"
#                (the default) and anything uv installs. Use these, or a venv:
#                  python3.15 -m venv ~/venvs/myproject

case "${1:-}" in
	-h | --help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

show() { # label interpreter
	if [ -x "$2" ]; then
		printf '  %-22s %-34s %s\n' "$1" "$2" "$("$2" -c 'import sys; print(".".join(map(str, sys.version_info[:3])))' 2> /dev/null)"
	fi
}

echo "System Python (for the OS, do not install packages into it):"
show "python3" /usr/bin/python3
echo
echo "User Pythons (for your work; pip installs into ~/.local or a venv):"
for dir in /opt/python/*/; do
	[ -d "$dir" ] || continue
	series="$(basename "$dir")"
	show "python$series" "/usr/local/bin/python$series"
done
if [ -L /usr/local/bin/python ]; then
	show "python (default)" "$(readlink -f /usr/local/bin/python)"
fi
if command -v uv > /dev/null 2>&1; then
	uv_list="$(uv python list --only-installed 2> /dev/null | grep -v '/opt/python\|/usr/bin' | sed 's/^/  /')"
	if [ -n "$uv_list" ]; then
		echo
		echo "Installed with uv:"
		echo "$uv_list"
	fi
fi
