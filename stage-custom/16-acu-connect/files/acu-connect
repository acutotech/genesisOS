#!/bin/sh
# acu-connect: the Acu Connect client's command line (signin, status, signout).
# The client itself runs as acu-connect.service; this only manages the link.
#
# Always Genesis OS's own Python (/opt/acu-connect/python), never the system
# python3. The link is kept in /var/lib/acu-connect, owned by the desktop user
# (uid 1000) the client runs as, so root's commands run as that user too.
set -e
# the only server this box connects to (acu-connect-service holds the same)
SERVER=https://connect.acutrotech.com
PYTHON=/opt/acu-connect/python/bin/python3
DEFAULTS=/etc/default/acu-connect
# present while a rename of the desktop user is pending (the same as acu-connect-service)
RENAME_PENDING="/etc/ssh/sshd_config.d/rename_user.conf /etc/systemd/system/multi-user.target.wants/userconfig.service"
RUNUSER=/usr/sbin/runuser
DESKTOP_UID=1000

# The settings in /etc/default/acu-connect, NAME=value lines read the way systemd's
# EnvironmentFile reads the usual forms (blanks around the line and around =, one
# pair of quotes, CRLF line ends), never run as shell. The command takes the
# client's ACU_* settings and the proxy variables; the service takes every line.
if [ -r "${DEFAULTS}" ]; then
	cr="$(printf '\r')"
	while IFS= read -r line || [ -n "${line}" ]; do
		line="${line%"${cr}"}"
		line="${line#"${line%%[![:space:]]*}"}"
		case "${line}" in
			"#"* | ";"* | "") continue ;;
			*=*) ;;
			*) continue ;;
		esac
		name="${line%%=*}"
		name="${name%"${name##*[![:space:]]}"}"
		value="${line#*=}"
		value="${value#"${value%%[![:space:]]*}"}"
		value="${value%"${value##*[![:space:]]}"}"
		case "${value}" in
			\"*\") value="${value#\"}"; value="${value%\"}" ;;
			\'*\') value="${value#\'}"; value="${value%\'}" ;;
		esac
		case "${name}" in
			"" | [0-9]* | *[!A-Za-z0-9_]*) continue ;;
			ACU_* | HTTPS_PROXY | https_proxy | HTTP_PROXY | http_proxy | ALL_PROXY | all_proxy | NO_PROXY | no_proxy) ;;
			*) continue ;;
		esac
		export "${name}=${value}"
	done < "${DEFAULTS}"
fi
export ACU_CONFIG_DIR="${ACU_CONFIG_DIR:-/var/lib/acu-connect}"
export ACU_SERVER="${SERVER}"

# The command and any --server, found the way the client parses its arguments: an
# --option takes the next word as its value unless that word is an option too.
command=""
option=""
server_given=""
server_ok=1
for arg in "$@"; do
	if [ -n "${option}" ]; then
		previous="${option}"
		option=""
		case "${arg}" in
			--*) ;;
			*)
				if [ "${previous}" = --server ] && [ "${arg%/}" != "${SERVER}" ]; then
					server_ok=""
				fi
				continue
				;;
		esac
		if [ "${previous}" = --server ]; then
			server_ok=""
		fi
	fi
	case "${arg}" in
		--server) server_given=1; option="${arg}" ;;
		--server=*) server_given=1; server_ok="" ;;
		--*) option="${arg}" ;;
		*) if [ -z "${command}" ]; then command="${arg}"; fi ;;
	esac
done
if [ "${option}" = --server ]; then
	server_ok=""
fi
if [ -n "${server_given}" ] && [ -z "${server_ok}" ]; then
	echo "acu-connect: this box connects only to ${SERVER}" >&2
	exit 1
fi
if [ "${command}" = run ] && [ "${ACU_CONNECT_MANUAL:-}" != 1 ]; then
	echo "acu-connect: the client already runs as acu-connect.service (systemctl status acu-connect);" >&2
	echo "acu-connect: a second one would not follow signin --force or signout. Ignore signin's \"acu-connect run\"." >&2
	exit 1
fi
if [ "${command}" = signin ] || [ "${command}" = run ]; then
	for marker in ${RENAME_PENDING}; do
		if [ -e "${marker}" ]; then
			echo "acu-connect: a rename of the desktop user is pending (first-boot wizard or rename-user);" >&2
			echo "acu-connect: finish it, or cancel it (sudo cancel-rename USER, then reboot), then link this box" >&2
			exit 1
		fi
	done
fi
if [ ! -x "${PYTHON}" ]; then
	echo "acu-connect: ${PYTHON} is missing; reinstall Genesis OS's acu-connect" >&2
	exit 1
fi

# A link to another server (made before the server was fixed, or by hand) is never sent
# anywhere: status and signout would hand its device token to this server. Only "same",
# "other" or "unreadable" comes back, never the link's own text.
link_state() {
	"${PYTHON}" -I -c '
import json, os, stat, sys
path = os.path.join(sys.argv[1], "agent.json")
try:
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
except OSError:
    sys.exit(0)
with os.fdopen(fd, "rb") as fh:
    try:
        st = os.fstat(fh.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_size > 65536:
            raise ValueError
        server = json.loads(fh.read(65537)).get("server")
    except Exception:
        print("unreadable")
        sys.exit(0)
print("same" if isinstance(server, str) and server.rstrip("/") == sys.argv[2] else "other")
' "${ACU_CONFIG_DIR}" "${SERVER}" 2> /dev/null || echo unreadable
}
case "${command}" in
	status | signout | run)
		state="$(link_state)"
		if [ "${state}" = other ] || [ "${state}" = unreadable ]; then
			if [ "${command}" = signout ]; then
				rm -f "${ACU_CONFIG_DIR}/agent.json"
				echo "Removed the local link (to another server, or unreadable) without contacting any server."
				exit 0
			fi
			echo "acu-connect: this box connects only to ${SERVER}, and its link is to another server (or unreadable):" >&2
			echo "acu-connect: link it again with sudo acu-connect signin --force" >&2
			exit 1
		fi
		;;
esac
if [ "$(id -u)" = 0 ]; then
	user="$(getent passwd "${DESKTOP_UID}" | cut -d: -f1)"
	if [ -n "${user}" ]; then
		# runuser by full path: root's PATH does not always have sbin (cron, env -i)
		exec "${RUNUSER}" -u "${user}" -- env ACU_CONFIG_DIR="${ACU_CONFIG_DIR}" "${PYTHON}" -I -m acu_connect "$@"
	fi
	# no desktop user: looking at the link and removing it are fine as root, a new one is not
	if [ "${command}" = signin ] || [ "${command}" = run ]; then
		echo "acu-connect: there is no desktop user (uid ${DESKTOP_UID}); the link must belong to that user" >&2
		exit 1
	fi
elif [ "$(id -u)" != "${DESKTOP_UID}" ] && [ ! -w "${ACU_CONFIG_DIR}" ]; then
	echo "acu-connect: the link belongs to the desktop user (uid ${DESKTOP_UID}): run this as that user or with sudo" >&2
	exit 1
fi
exec "${PYTHON}" -I -m acu_connect "$@"
