#!/opt/acu-connect/python/bin/python3 -I
"""acu-connect-service: keeps the Acu Connect client running (acu-connect.service).

The client (`acu-connect run`) needs a linked device: until someone runs
`acu-connect signin` and approves the code, this waits quietly instead of letting
systemd restart a failing client every few seconds. Once linked it runs the
client, restarts it with a growing pause if it ever stops, and when the device is
removed from the account (the client exits with 2) it sets that link aside and
waits for a new signin, so the service never ends up stopped for good.

The service itself runs as root and starts the client as the desktop user (uid
1000, whatever its name is now) only while that is safe:
  - not while a rename of that user is pending (Raspberry Pi's first-boot wizard
    or rename-user, desktop or console: rename_user.conf and the enabled
    userconfig.service exist until the rename is done or cancelled), nor while
    the wizard's session runs: usermod cannot rename a user that has running
    processes, and the wizard would leave the account half renamed. A client
    that is already running is stopped only when the wizard session itself
    starts, not when rename-user arms it: rename-user may be running in one of
    the client's own remote shells, and the rename happens after a reboot;
  - not with a link other than the one it started with: `acu-connect signin
    --force` or `signout` take effect at once, and a revoke reported by the old
    client never sets aside a new link.

It runs on Genesis OS's own Python (/opt/acu-connect/python), never the system
python3, so apt upgrades and a new system Python version cannot break it.
"""

import os
import pwd
import signal
import stat
import subprocess
import sys
import time

DEFAULT_DIR = "/var/lib/acu-connect"
CONFIG_DIR = os.environ.get("ACU_CONFIG_DIR") or DEFAULT_DIR
CONFIG = os.path.join(CONFIG_DIR, "agent.json")
# Tests point these at stand-ins; the image runs the client on this interpreter as uid 1000.
CLIENT = os.environ.get("ACU_CONNECT_CLIENT", "").split() or [sys.executable, "-I", "-m", "acu_connect"]
UID = int(os.environ.get("ACU_CONNECT_UID") or 1000)
# present while a rename of the desktop user is pending: rename-user creates both in either
# boot mode, and cancel-rename (which the wizard and userconf end with) removes both. The
# second one does not need openssh-server (whose sshd_config.d the first one lives in).
RENAME_MARKERS = "/etc/ssh/sshd_config.d/rename_user.conf:/etc/systemd/system/multi-user.target.wants/userconfig.service"
HOLD = [p for p in (os.environ.get("ACU_CONNECT_HOLD") or RENAME_MARKERS).split(":") if p]
# the user the first-boot wizard's session runs as; while it has processes, the rename is under way
WIZARD = os.environ.get("ACU_CONNECT_WIZARD_USER") or "rpi-first-boot-wizard"
PROC = os.environ.get("ACU_CONNECT_PROC") or "/proc"
POLL = float(os.environ.get("ACU_CONNECT_POLL") or 10)          # seconds between checks while waiting
FIRST_PAUSE = float(os.environ.get("ACU_CONNECT_PAUSE") or 5)   # after the client stops; doubles up to MAX_PAUSE
GRACE = float(os.environ.get("ACU_CONNECT_GRACE") or 10)        # SIGTERM, then this long before SIGKILL
MAX_PAUSE = 60
STEADY = 300            # a client that ran this long gets the first pause again
TICK = min(1.0, POLL)   # how often the link is checked while the client runs
EXIT_REVOKED = 2        # acu_connect.daemon.EXIT_REVOKED: the device was removed from the account
RESTART = "restart"     # run_client: the supervisor stopped the client itself (link changed, rename pending)
# systemd's bookkeeping for this service, not for the client or the remote shells it opens
NOT_FOR_CLIENT = {"INVOCATION_ID", "JOURNAL_STREAM", "NOTIFY_SOCKET", "SYSTEMD_EXEC_PID", "MANAGERPID",
                  "MAINPID", "WATCHDOG_PID", "WATCHDOG_USEC", "PYTHONUNBUFFERED"}

stopping = False     # set by the signal handler: a plain flag, no locks (a handler must not take any)
child = None


def log(message):
    print(f"acu-connect-service: {message}", flush=True)


def link():
    """Which link agent.json holds right now (file identity), or None when the device is not linked."""
    try:
        st = os.stat(CONFIG)
    except OSError:
        return None
    if not stat.S_ISREG(st.st_mode):
        return None
    return (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns)


def held():
    """The marker of a pending rename of the desktop user, if one exists."""
    return next((path for path in HOLD if os.path.lexists(path)), None)


def wizard_running():
    """Whether the first-boot wizard's session is running (its user has processes)."""
    try:
        uid = pwd.getpwnam(WIZARD).pw_uid
    except KeyError:
        return False
    try:
        entries = os.scandir(PROC)
    except OSError:
        return False
    with entries:
        for entry in entries:
            if entry.name.isdigit():
                try:
                    if entry.stat(follow_symlinks=False).st_uid == uid:
                        return True
                except OSError:
                    continue
    return False


def pause_for(seconds):
    """Sleep, waking early when the service is stopped."""
    deadline = time.monotonic() + seconds
    while not stopping:
        left = deadline - time.monotonic()
        if left <= 0:
            return
        time.sleep(min(left, 0.2))


def account():
    """The desktop user as it is now: Genesis Imager and the first-boot wizard rename it, the uid stays."""
    try:
        return pwd.getpwuid(UID)
    except KeyError:
        return None


def switching():
    return os.geteuid() != UID


def prepare_dir(user):
    """The link directory exists and belongs to the desktop user, who writes agent.json (signin).

    Only /var/lib/acu-connect, or a directory this creates, is handed to that user: a
    directory ACU_CONFIG_DIR names that already exists is left as it is. Returns a
    problem to report, or None.
    """
    if os.geteuid() != 0 or user is None:
        return None
    created = False
    try:
        os.mkdir(CONFIG_DIR, 0o700)
        created = True
    except FileExistsError:
        pass
    except OSError as why:
        return f"cannot create {CONFIG_DIR}: {why}"
    try:
        st = os.lstat(CONFIG_DIR)
        if stat.S_ISLNK(st.st_mode) and os.path.isdir(CONFIG_DIR):
            return None          # moved elsewhere by the admin: theirs to look after
        if not stat.S_ISDIR(st.st_mode):
            return f"{CONFIG_DIR} is not a directory"
        if not created and os.path.abspath(CONFIG_DIR) != DEFAULT_DIR:
            return None
        if (st.st_uid, st.st_gid) != (user.pw_uid, user.pw_gid):
            os.chown(CONFIG_DIR, user.pw_uid, user.pw_gid, follow_symlinks=False)
        if stat.S_IMODE(st.st_mode) != 0o700:
            os.chmod(CONFIG_DIR, 0o700, follow_symlinks=False)
    except (OSError, NotImplementedError) as why:
        return f"cannot give {CONFIG_DIR} to {user.pw_name}: {why}"
    return None


def wayland_display(env):
    """The Wayland socket of the desktop session, if one exists (labwc usually makes wayland-0)."""
    runtime = env.get("XDG_RUNTIME_DIR") or f"/run/user/{UID}"
    try:
        sockets = sorted(n for n in os.listdir(runtime) if n.startswith("wayland-") and not n.endswith(".lock"))
    except OSError:
        sockets = []
    return sockets[0] if sockets else env.get("WAYLAND_DISPLAY") or "wayland-0"


def client_env(user):
    env = {k: v for k, v in os.environ.items() if k not in NOT_FOR_CLIENT and not k.startswith("ACU_CONNECT_")}
    if switching():
        env.update(HOME=user.pw_dir, USER=user.pw_name, LOGNAME=user.pw_name, SHELL=user.pw_shell or "/bin/sh")
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{UID}")
    env["WAYLAND_DISPLAY"] = wayland_display(env)
    env.setdefault("ACU_CONFIG_DIR", CONFIG_DIR)
    return env


def set_aside():
    """The device was removed from the account: keep its old link for reference, wait for a new one."""
    try:
        os.replace(CONFIG, CONFIG + ".revoked")
    except OSError as why:
        log(f"could not set the old link aside: {why}")


def run_client(user, started_link):
    """Run the client until it exits: its exit code, or RESTART when this stopped it (or None when stopping)."""
    global child
    options = {}
    if switching():
        options = {"user": user.pw_uid, "group": user.pw_gid,
                   "extra_groups": os.getgrouplist(user.pw_name, user.pw_gid),
                   "cwd": user.pw_dir if os.path.isdir(user.pw_dir) else "/"}
    if stopping:
        return None
    try:
        child = subprocess.Popen([*CLIENT, "run"], env=client_env(user), **options)
    except (OSError, ValueError, subprocess.SubprocessError) as why:
        log(f"cannot start the client: {why}")
        return 1
    reason = None
    deadline = None
    try:
        while True:
            try:
                code = child.wait(timeout=TICK)
                return None if stopping else RESTART if reason else code
            except subprocess.TimeoutExpired:
                pass
            if reason is None:
                now_link = link()
                if stopping:
                    reason = "stopping"
                elif now_link is None:
                    reason = "the link was removed (signout); stopping the client"
                elif now_link != started_link:
                    reason = "the link changed (signin); restarting the client on the new link"
                elif wizard_running():
                    reason = f"the first-boot wizard is renaming {user.pw_name}; stopping the client until it is done"
                if reason:
                    if reason != "stopping":
                        log(reason)
                    child.terminate()
                    deadline = time.monotonic() + GRACE
            elif time.monotonic() >= deadline:
                log(f"the client did not stop within {GRACE:g} s; killing it")
                child.kill()
                deadline = float("inf")
    finally:
        child = None


def stop(_signum, _frame):
    global stopping
    stopping = True
    running = child
    if running is not None and running.returncode is None:
        try:
            running.send_signal(signal.SIGTERM)
        except OSError:
            pass


def main():
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    pause = FIRST_PAUSE
    waiting = None
    problem = None
    while not stopping:
        user = account()
        trouble = prepare_dir(user)
        if trouble != problem:
            if trouble:
                log(trouble)
            problem = trouble
        current = link()
        hold = held()
        if current is None:
            why = 'this device is not linked yet: run "acu-connect signin" and approve the code to link it'
        elif hold:
            why = f"waiting for the rename of the desktop user to be done or cancelled ({hold} exists)"
        elif wizard_running():
            # cancel-rename does not end the wizard's session, and that wizard can still rename
            why = "the first-boot wizard's session is still running; reboot (or restart lightdm) to end it"
        elif user is None:
            why = f"there is no user with uid {UID}; waiting for one"
        else:
            why = None
        if why:
            if why != waiting:
                log(why)
                waiting = why
            pause_for(POLL)
            continue
        if waiting:
            log(f"linked; starting the client as {user.pw_name}")
            waiting = None
        started = time.monotonic()
        code = run_client(user, current)
        if stopping or code is None:
            break
        if code == RESTART:
            pause = FIRST_PAUSE
            continue
        if code == EXIT_REVOKED:
            now = link()
            if now is None:
                continue                  # signed out meanwhile: wait for a new signin
            if now != current:
                log("the old link was revoked; a new one is in place")
                pause = FIRST_PAUSE
                continue
            set_aside()
            if link() is None:
                pause = FIRST_PAUSE
                continue
            # the link could not be set aside: do not start a revoked client over and over
        if time.monotonic() - started >= STEADY:
            pause = FIRST_PAUSE
        log(f"the client stopped (exit {code}); starting it again in {pause:g} s")
        pause_for(pause)
        pause = min(MAX_PAUSE, pause * 2)
    return 0


if __name__ == "__main__":
    sys.exit(main())
