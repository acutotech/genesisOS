# Acu Connect client settings (acu-connect.service and the acu-connect command).
# After a change: sudo systemctl restart acu-connect
# NAME=value lines (never run as shell). The service reads every line; the
# acu-connect command reads the ACU_* settings and the proxy variables.
#
# Server for signin, status and signout. The running client always uses the server
# the box was linked to, so change this before linking, not after.
#ACU_SERVER=https://connect.acutrotech.com
# a proxy, if the box reaches the internet only through one
#HTTPS_PROXY=http://proxy.example:3128
#NO_PROXY=localhost,127.0.0.1
# 0: don't look up the approximate location (ipinfo.io)
#ACU_NETWORK_LOCATION=0
# desktop sharing: frames per second (1-30), JPEG quality (1-100), scale (e.g. 0.5)
#ACU_SCREEN_FPS=5
#ACU_SCREEN_QUALITY=60
#ACU_SCREEN_SCALE=1
# 1: never accept mouse and keyboard input
#ACU_DISABLE_INPUT=1
# poll: skip WebSockets and use ordinary web requests
#ACU_TRANSPORT=poll
